# OpenDART 인증키 — https://opendart.fss.or.kr 에서 발급 (일 20,000건 제한)
# TODO(API): 키 발급 후 이 파일을 .env 로 복사하고 값을 채울 것. 코드 수정은 불필요.
OPENDART_KEY=

# Phase 6에서 사용할 LLM API 키. Phase 0~5에서는 사용하지 않는다 (비용 0원).
# TODO(API): Phase 6 진입 시점에 채울 것.
LLM_API_KEY=

# KRX 정보데이터시스템 계정 (data.krx.co.kr)
# Phase 1 의 '연도 말 시가총액 상위 800' 유니버스 선정에 필요하다.
# pykrx 가 이 두 값을 환경변수로 읽는다. 코드에 넣지 말고 여기(.env)에만 둘 것.
KRX_ID=
KRX_PW=
